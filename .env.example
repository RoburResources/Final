# Required: the key the server uses to reach Claude.
ANTHROPIC_API_KEY=

# Strongly recommended on a public URL. When set, claiming the app for the
# first time also requires this code, so a passer-by cannot claim it before
# you do. Any hard-to-guess string.
TALKBACK_CLAIM_CODE=

# Optional. A base64url secret used to sign sessions. Set it if the host wipes
# the disk on redeploy, so you are not signed out every time.
TALKBACK_HMAC_KEY=

# Optional. Where store.json lives. Point it at a mounted disk if you have one.
TALKBACK_DATA_DIR=

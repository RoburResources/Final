{
  "name": "talkback",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A private live voice line to Claude, behind a Face ID login.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"node --watch server.js\" \"vite\"",
    "build": "vite build",
    "start": "node server.js",
    "serve": "npm run build && node server.js",
    "test": "node test/webauthn.e2e.mjs && node test/chat.e2e.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.456.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}

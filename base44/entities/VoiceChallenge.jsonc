{
  "name": "VoiceChallenge",
  "type": "object",
  "description": "Single-use WebAuthn challenge. Consumed on verify so an assertion cannot be replayed.",
  "properties": {
    "challenge": { "type": "string" },
    "purpose": { "type": "string", "enum": ["enrol", "verify"] },
    "expires_at": { "type": "number" }
  },
  "required": ["challenge", "purpose", "expires_at"],
  "permissions": {
    "public": { "read": false, "create": false, "update": false, "delete": false },
    "user":   { "read": false, "create": false, "update": false, "delete": false },
    "admin":  { "read": false, "create": false, "update": false, "delete": false }
  }
}

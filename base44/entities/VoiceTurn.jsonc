{
  "name": "VoiceTurn",
  "type": "object",
  "description": "One turn of a spoken conversation.",
  "properties": {
    "role": { "type": "string", "enum": ["user", "assistant"] },
    "text": { "type": "string" },
    "said_at": { "type": "string", "format": "date-time" }
  },
  "required": ["role", "text"],
  "permissions": {
    "public": { "read": false, "create": false, "update": false, "delete": false },
    "user":   { "read": true,  "create": false, "update": false, "delete": true },
    "admin":  { "read": true,  "create": true,  "update": true,  "delete": true }
  }
}

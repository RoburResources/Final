# Replit: click Run to build the UI and start the server on one port.
run = "npm run serve"
entrypoint = "server.js"
modules = ["nodejs-20"]

hidden = [".config", "dist", "node_modules", "data"]

[nix]
channel = "stable-24_05"

[env]
NODE_ENV = "production"

[deployment]
build = ["sh", "-c", "npm install && npm run build"]
run = ["sh", "-c", "node server.js"]
# Reserved VM keeps a persistent disk, so the enrolled passkey and the
# transcript survive a restart. On Autoscale the disk is wiped between
# instances — set TALKBACK_CLAIM_CODE and TALKBACK_HMAC_KEY if you use it.
deploymentTarget = "gce"

[[ports]]
localPort = 3000
externalPort = 80
